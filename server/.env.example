# Export these variables in your shell/container. .env is not auto-loaded.
# Alternatively use private root config.json (never put secrets under public/).
YOUTUBE_API_KEY=
# Private config.json keys: youtubeApiKey, youtubeHandle (default @xiazheteng8)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_KEY=
# Gemini: AI_PROVIDER=gemini, AI_MODEL=gemini-2.5-flash,
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SITE_URL=https://blog.example.com
# Optional override to a private config file:
# XBLOG_CONFIG_FILE=/app/config.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADMIN_IDENTIFIER=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_IDENTIFIER=
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=
QQ_ADMIN_IDENTIFIER=
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
WECHAT_ADMIN_IDENTIFIER=
# settings.oauthConfig (JSON object), e.g.:
# {"google":{"enabled":true,"clientId":"public-id","callbackUrl":"https://blog.example.com/api/auth/google/callback","adminIdentifier":"verified-email@example.com"}}
# Private config.json merges per provider, e.g.:
# {"oauthConfig":{"google":{"clientSecret":"PRIVATE"}}}
# Google/GitHub adminIdentifier: provider numeric subject ID or verified email.
# QQ/WeChat adminIdentifier: application-scoped openid. No automatic email linking.
# In-memory OAuth states expire in 10 minutes; sessions are lost on restart.
